# INCIDEX -> SiteRecall: Environment Variables Template
# Copy this file to .env.local and insert your real credentials.
# NEVER commit .env.local to GitHub!
# ==============================================================================

# Hindsight Memory Configuration (Vectorize.io)
# Sign up at https://ui.hindsight.vectorize.io (Use promo code: MEMHACK99 for $50 free credits)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=siterecall_production_sre

# Google Vertex AI / Gemini 3.8 Flash Configuration
# Get your API key or Service Account from Google Cloud Vertex AI
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Groq API Key (alternative ultra-fast LLM fallback)
GROQ_API_KEY=your_groq_api_key_here

# App Port (Default: 3000)
PORT=3000
